# =============================================================================
# Launchpad Server Environment Configuration
# =============================================================================

# Server Ports
PORT=5000
SITE_PORT=8000

# Client Application URL (used for OAuth redirect)
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Session Signing
JWT_SECRET="launchpad-super-secret-jwt-key-change-in-production"

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:5000/auth/github/callback"

