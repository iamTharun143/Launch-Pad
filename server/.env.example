# =============================================================================
# Launchpad Server Environment Configuration
# =============================================================================

# Server Ports
PORT=5000
SITE_PORT=8000

# Client Application URL (used for OAuth redirect)
CLIENT_URL=http://localhost:5173

# Database Connection (Default: SQLite local dev file, or Supabase PostgreSQL)
# For local dev with SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL (e.g. Supabase):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Session Signing
JWT_SECRET="launchpad-super-secret-jwt-key-change-in-production"

# GitHub OAuth Application Credentials (Optional for local dev with /auth/dev-token)
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/auth/github/callback"
